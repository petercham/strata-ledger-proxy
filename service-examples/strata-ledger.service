[Unit]
Description=Strata ledger proxy watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 改成实际解压目录
WorkingDirectory=/opt/strata-ledger-proxy
# 改成实际 python3 路径（which python3）
ExecStart=/usr/bin/python3 /opt/strata-ledger-proxy/ledger_watchdog.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/strata-ledger-proxy/data/systemd.log
StandardError=append:/opt/strata-ledger-proxy/data/systemd.log

[Install]
WantedBy=multi-user.target
